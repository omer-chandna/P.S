{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the P.S. main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:event:default",
    "allow-get-settings",
    "allow-update-settings",
    "allow-ollama-status",
    "allow-list-models",
    "allow-activate-model",
    "allow-delete-model",
    "allow-pull-model",
    "allow-cancel-pull",
    "allow-hardware-recommendations",
    "allow-optimize-text",
    "allow-cancel-optimization",
    "allow-attention",
    "allow-dismiss-attention",
    "allow-accept-attention",
    "allow-shortcut-info",
    "allow-permission-info",
    "allow-open-permission-settings",
    "allow-open-external",
    "allow-app-info",
    "allow-finish-onboarding",
    "allow-copy-text"
  ]
}
